---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}
---

<BaseLayout title={Astro.props.title} description={Astro.props.description} canonical={Astro.props.canonical}>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</BaseLayout>
